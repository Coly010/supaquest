# Copy this file to .env.local and fill in your local Supabase values.
# Run `supabase start` to get these values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# "Publishable" key from the "Authentication Keys" table in `supabase start` output
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# "Secret" key from the "Authentication Keys" table — only used in Edge Functions, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
